# Copy to ntn-roblox.toml in your project root (the directory you run ntn-roblox from).
# Safe to commit in your game repo — secrets belong in .env only.

[notion]
# Parent page where `ntn-roblox init` creates the three databases (32-char hex ID from the page URL).
# Share this page with your integration before running init.
parent_page_id = ""
# Filled by `ntn-roblox init --write-toml`, or set manually if you create databases yourself.
dev_product_db_id = ""
game_pass_db_id   = ""
badge_db_id       = ""

[roblox]
universe_id = 1234567890
# badge_payment_source = "user"

[logging]
# level = "info"
